# Top-level allowlist (BlankOn/irgsh-go#244): ignore every root entry, then
# re-include each tracked root file and directory. A new root file or
# directory needs an explicit `!` entry here.
/*
!/.github/
!/.gitignore
!/.gitpod.Dockerfile
!/.gitpod.yaml
!/AGENTS.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/COPYING
!/DESIGN.md
!/e-files
!/GPG-EN.md
!/GPG-ID.md
!/HACKING.md
!/Makefile
!/README.md
!/VERSION
!/cmd/
!/debian/
!/e2e/
!/go.mod
!/go.sum
!/install-cli.sh
!/install.sh
!/internal/
!/pkg/
!/utils/
.env
bin
latest
tmp
target
irgsh-go
builder/utils.go
repo/utils.go
cli/utils.go
coverage.txt
debian-build
obj-x86_64-linux-gnu
notes
.planning/
debian/.debhelper/generated/irgsh-cli/
debian/irgsh-cli/
debian/irgsh-cli.debhelper.log
debian/irgsh-cli.substvars
